# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
VITE_DEV_MODE=false

# Game server for saving/leaderboards (../Bowling-roll-backend). Leave empty to use ws://localhost:2567 in dev
# builds and the Bloxity matchmaker in production.
VITE_SERVER_URL=
